.program quadrature_counter
  jmp update
  jmp decrement
  jmp increment
  jmp update

  jmp increment
  jmp update
  jmp update
  jmp decrement

  jmp decrement
  jmp update
  jmp update
  jmp increment

  jmp update
  jmp increment

decrement:
  jmp y--, update

update:
  wrap_target:
  set x, 0
  pull noblock
  mov x, osr
  mov osr, isr
  jmp !x, sample_pins
  mov isr, y
  push

sample_pins:
  mov isr, null
  in osr, 2
  in pins, 2
  mov pc, isr

increment:
  mov x, ~y
  jmp x--, increment2
increment2:
  mov y, ~x
  wrap:

  nop
  nop
  nop

% c-sdk {
static inline void quadrature_counter_program_init(PIO pio,
                                                   uint sm,
                                                   uint offset,
                                                   uint pin_a,
                                                   float clkdiv) {
  pio_gpio_init(pio, pin_a);
  pio_gpio_init(pio, pin_a + 1);
  gpio_pull_up(pin_a);
  gpio_pull_up(pin_a + 1);
  pio_sm_set_consecutive_pindirs(pio, sm, pin_a, 2, false);

  pio_sm_config c = quadrature_counter_program_get_default_config(offset);
  sm_config_set_in_pins(&c, pin_a);
  sm_config_set_clkdiv(&c, clkdiv);
  pio_sm_init(pio, sm, offset, &c);
  pio_sm_set_enabled(pio, sm, true);
}
%}
